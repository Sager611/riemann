  rcases (by omega : N % 12 = 0 ∨ N % 12 = 1 ∨ N % 12 = 2 ∨ N % 12 = 3 ∨ N % 12 = 4 ∨ N % 12 = 5 ∨ N % 12 = 6 ∨ N % 12 = 7 ∨ N % 12 = 8 ∨ N % 12 = 9 ∨ N % 12 = 10 ∨ N % 12 = 11) with h | h | h | h | h | h | h | h | h | h | h | h
  · exact ⟨6, by decide, (N - 12) / 12, by omega, Nat.le_trans (by decide : (pt 6).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨7, by decide, (N - 13) / 12, by omega, Nat.le_trans (by decide : (pt 7).qstar ≤ 2) (by omega), by omega⟩
