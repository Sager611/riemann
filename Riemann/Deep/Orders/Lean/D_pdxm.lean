  · exact ⟨0, by decide, (N - 9) / 12, by omega, Nat.le_trans (by decide : (pt 0).qstar ≤ 1) (by omega), by omega⟩
  · exact ⟨1, by decide, (N - 10) / 12, by omega, Nat.le_trans (by decide : (pt 1).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨2, by decide, (N - 11) / 12, by omega, Nat.le_trans (by decide : (pt 2).qstar ≤ 1) (by omega), by omega⟩

/-- Theorem 2 for this order: a perfect sequence for every N ≥ 9. -/
theorem works : ∀ N, 9 ≤ N → ∃ ms, Perfect ord N ms :=
  works_of ord_perm 3 9 44 (by decide) pt offs patches_ok
    base cov

end Orders.D_pdxm
