theorem cov : ∀ N, 47 ≤ N → ∃ c ∈ offs, ∃ q, N = 3 * (4 * q + 0) + c ∧ (pt c).qstar ≤ q ∧ 12 ≤ 4 * q + 0 := by
  intro N hN
  rcases (by omega : N % 12 = 0 ∨ N % 12 = 1 ∨ N % 12 = 2 ∨ N % 12 = 3 ∨ N % 12 = 4 ∨ N % 12 = 5 ∨ N % 12 = 6 ∨ N % 12 = 7 ∨ N % 12 = 8 ∨ N % 12 = 9 ∨ N % 12 = 10 ∨ N % 12 = 11) with h | h | h | h | h | h | h | h | h | h | h | h
  · exact ⟨0, by decide, (N - 0) / 12, by omega, Nat.le_trans (by decide : (pt 0).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨1, by decide, (N - 1) / 12, by omega, Nat.le_trans (by decide : (pt 1).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨2, by decide, (N - 2) / 12, by omega, Nat.le_trans (by decide : (pt 2).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨3, by decide, (N - 3) / 12, by omega, Nat.le_trans (by decide : (pt 3).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨4, by decide, (N - 4) / 12, by omega, Nat.le_trans (by decide : (pt 4).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨5, by decide, (N - 5) / 12, by omega, Nat.le_trans (by decide : (pt 5).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨6, by decide, (N - 6) / 12, by omega, Nat.le_trans (by decide : (pt 6).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨7, by decide, (N - 7) / 12, by omega, Nat.le_trans (by decide : (pt 7).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨8, by decide, (N - 8) / 12, by omega, Nat.le_trans (by decide : (pt 8).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨9, by decide, (N - 9) / 12, by omega, Nat.le_trans (by decide : (pt 9).qstar ≤ 2) (by omega), by omega⟩
  · exact ⟨10, by decide, (N - 10) / 12, by omega, Nat.le_trans (by decide : (pt 10).qstar ≤ 2) (by omega), by omega⟩
