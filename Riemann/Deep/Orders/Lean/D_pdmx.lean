/-- Theorem 2 for this order: a perfect sequence for every N ≥ 12. -/
theorem works : ∀ N, 12 ≤ N → ∃ ms, Perfect ord N ms :=
  works_of ord_perm 0 12 47 (by decide) pt offs patches_ok
    base cov

end Orders.D_pdmx
