    a - a ^ 3 / 6 ≤ F.sin a ∧ F.sin a ≤ a - a ^ 3 / 6 + a ^ 5 / 100 := by
  have habs : |a| ≤ 1 := by rw [abs_of_pos ha]; exact ha1
  have hs := F.sin_bound a habs
  rw [abs_of_pos ha, abs_le] at hs
  exact ⟨(F.sin_gt_sub_cube a ha).le, by linarith [hs.2]⟩

/-- cos 2b = 1 − 2 sin² b, with bounds (Real.cos_two_mul, Real.sin_sq_add_cos_sq). -/
theorem cos_two {b sl sh cl' ch' : ℝ} (hs : sl ≤ F.sin b ∧ F.sin b ≤ sh) (h0 : 0 ≤ sl)
    (e3 : cl' ≤ 1 - 2 * sh ^ 2) (e4 : 1 - 2 * sl ^ 2 ≤ ch') : cl' ≤ F.cos (2 * b) ∧ F.cos (2 * b) ≤ ch' := by
  have hcos2 : F.cos (2 * b) = 1 - 2 * F.sin b ^ 2 := by
    rw [F.cos_two_mul]; have := F.sin_sq_add_cos_sq b; linarith
  have hsb : 0 ≤ F.sin b := h0.trans hs.1
  have hsh : 0 ≤ sh := hsb.trans hs.2
  rw [hcos2]
  constructor
  · nlinarith [mul_le_mul hs.2 hs.2 hsb hsh]
  · nlinarith [mul_le_mul hs.1 hs.1 h0 hsb]

