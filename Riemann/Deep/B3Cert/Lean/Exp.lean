  rw [h2]
  exact e.trans (mul_le_mul h h h0 (h0.trans h))

/-- e^y ≤ u ⟹ u² ≤ u' ⟹ e^(2y) ≤ u'. -/
theorem sq_up {y u u' : ℝ} (h : F.exp y ≤ u) (e : u * u ≤ u') : F.exp (2 * y) ≤ u' := by
