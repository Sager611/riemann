import Riemann.Deep.LeanPrefix.WreathA
import Mathlib.Algebra.Group.Submonoid.Finite

/-!
# Lemma 6 (B.3), part 2: G ≅ D_{2α} ≀ D_{2q}

ψ = transport of the imprimitive action along the block coordinates. ψ maps wN, wM, wK to
r_n, r_m, r_k, so G ≤ range ψ. Conversely H = ψ⁻¹(G) is everything (NOTE Lemma 6): T = r_n r_m is
wT = (mulSingle 0 (sr 1), r 1); T^q = (const sr 1, 1); T^q r_k T^{-q} = (mulSingle 0 (sr 0), 1);
with r_k = (mulSingle 0 (sr 2), 1) these generate D_{2α} on block 0 (α odd); conjugation by T
moves block j to block j + 1; the base is generated by its single-block elements; the top
D_{2q} is generated by sr 1, sr 2 (the block actions of r_n, r_m).
-/

namespace Riemann.Deep.LeanPrefix

open Equiv DihedralGroup SemidirectProduct

/-- The imprimitive action transported to Fin n along the block coordinates. -/
noncomputable def wreathToPerm {n q α : ℕ} [NeZero q] [NeZero α] (hn : n = q * α) :
    Wreath α q →* Perm (Fin n) :=
  (blockEquiv hn).symm.permCongrHom.toMonoidHom.comp (wreathPerm α q)

theorem wreathToPerm_apply {n q α : ℕ} [NeZero q] [NeZero α] (hn : n = q * α) (w : Wreath α q)
    (x : Fin n) : wreathToPerm hn w x = (blockEquiv hn).symm (wreathPerm α q w (blockEquiv hn x)) := rfl

theorem wreathToPerm_eq {n q α : ℕ} [NeZero q] [NeZero α] (hn : n = q * α) (w : Wreath α q)
    (g : Perm (Fin n)) (h : ∀ x, blockEquiv hn (g x) = wreathPerm α q w (blockEquiv hn x)) :
    wreathToPerm hn w = g := by
  ext x; rw [wreathToPerm_apply, ← h, Equiv.symm_apply_apply]

theorem wreathToPerm_injective {n q α : ℕ} [NeZero q] [NeZero α] (hn : n = q * α) (hq : 3 ≤ q)
    (hα : 3 ≤ α) : Function.Injective (wreathToPerm hn) :=
  (blockEquiv hn).symm.permCongrHom.injective.comp (wreathPerm_injective hα hq)

theorem r_pow_eq {α : ℕ} (a : ZMod α) (j : ℕ) : (r a : DihedralGroup α) ^ j = r ((j : ZMod α) * a) := by
  induction j with
  | zero => simp [r_zero]
  | succ j ih => rw [pow_succ, ih, r_mul_r]; push_cast; ring_nf

/-- A subgroup of DihedralGroup α (α odd) containing sr 0 and sr 2 is everything. -/
theorem dihedral_eq_top_of_sr {α : ℕ} [NeZero α] (hodd : α % 2 = 1) (K : Subgroup (DihedralGroup α))
    (h0 : sr 0 ∈ K) (h2 : sr 2 ∈ K) : K = ⊤ := by
  have hr2 : r 2 ∈ K := by
    have : (sr 0 * sr 2 : DihedralGroup α) = r 2 := by rw [sr_mul_sr]; ring_nf
    rw [← this]; exact K.mul_mem h0 h2
  have hr1 : r 1 ∈ K := by
    have h := K.pow_mem hr2 ((α + 1) / 2)
    rw [r_pow_eq] at h
    have e : (((α + 1) / 2 : ℕ) : ZMod α) * 2 = 1 := by
      have h1 : ((α + 1) / 2) * 2 = α + 1 := by omega
      have h2 : ((((α + 1) / 2) * 2 : ℕ) : ZMod α) = ((α + 1 : ℕ) : ZMod α) := by rw [h1]
      push_cast at h2; rw [h2, ZMod.natCast_self, zero_add]
    rwa [e] at h
  rw [eq_top_iff]
  rintro (i | i) -
  · have := K.pow_mem hr1 i.val
    rwa [r_one_pow, ZMod.natCast_zmod_val] at this
  · have hri : r (-i) ∈ K := by
      have := K.pow_mem hr1 (-i).val
      rwa [r_one_pow, ZMod.natCast_zmod_val] at this
    have : (r (-i) * sr 0 : DihedralGroup α) = sr i := by rw [r_mul_sr]; ring_nf
    rw [← this]; exact K.mul_mem hri h0

/-- A subgroup of DihedralGroup q containing sr 1 and sr 2 is everything. -/
theorem dihedral_eq_top_of_sr12 {q : ℕ} [NeZero q] (K : Subgroup (DihedralGroup q))
    (h1 : sr 1 ∈ K) (h2 : sr 2 ∈ K) : K = ⊤ := by
  have hr1 : r 1 ∈ K := by
    have : (sr 1 * sr 2 : DihedralGroup q) = r 1 := by rw [sr_mul_sr]; ring_nf
    rw [← this]; exact K.mul_mem h1 h2
  rw [eq_top_iff]
  rintro (i | i) -
  · have := K.pow_mem hr1 i.val
    rwa [r_one_pow, ZMod.natCast_zmod_val] at this
  · have hri : r (1 - i) ∈ K := by
      have := K.pow_mem hr1 (1 - i).val
      rwa [r_one_pow, ZMod.natCast_zmod_val] at this
    have : (r (1 - i) * sr 1 : DihedralGroup q) = sr i := by rw [r_mul_sr]; ring_nf
    rw [← this]; exact K.mul_mem hri h1

theorem dihedralPerm_inv_sr {q : ℕ} (i x : ZMod q) : (dihedralPerm q (sr i))⁻¹ x = -x - i := by
  rw [← map_inv, inv_sr]; rfl

theorem dihedralPerm_inv_r {q : ℕ} (i x : ZMod q) : (dihedralPerm q (r i))⁻¹ x = x - i := by
  rw [← map_inv, inv_r, dihedralPerm_r]; ring

section iso

variable {q α : ℕ} [NeZero q] [NeZero α]

/-- wT = wN wM: T = r_n r_m in wreath coordinates. -/
theorem wN_mul_wM : wN α q * wM α q = ⟨Pi.mulSingle 0 (sr 1), r 1⟩ := by
  ext i
  · simp only [mul_left, wN, wM, Pi.mul_apply, wreathAct_apply, dihedralPerm_inv_sr]
    by_cases hi : i = 0
    · subst hi; simp [sr_mul_self]
    · have : -i - 1 ≠ -1 := by intro h; apply hi; linear_combination -h
      rw [if_neg this, sr_mul_self, Pi.mulSingle_eq_of_ne hi]
  · simp only [mul_right, wN, wM, sr_mul_sr]; ring_nf

theorem wT_pow (hq : 2 ≤ q) (t : ℕ) (ht : t ≤ q) :
    (⟨Pi.mulSingle 0 (sr 1), r 1⟩ : Wreath α q) ^ t =
      ⟨fun i => if i.val < t then sr 1 else 1, r t⟩ := by
  induction t with
  | zero =>
    ext i
    · simp only [pow_zero, one_left, Pi.one_apply]; simp
    · simp [pow_zero, one_right, r_zero]
  | succ t ih =>
    rw [pow_succ', ih (by omega)]
    ext i
    · simp only [mul_left, Pi.mul_apply, wreathAct_apply, dihedralPerm_inv_r]
      by_cases hi : i = 0
      · subst hi
        have hv : (0 - 1 : ZMod q).val = q - 1 := by
          rw [zero_sub]
          have : (-1 : ZMod q) = ((q - 1 : ℕ) : ZMod q) := by
            rw [Nat.cast_sub (by omega), ZMod.natCast_self]; ring
          rw [this, ZMod.val_natCast, Nat.mod_eq_of_lt (by omega)]
        rw [hv, if_neg (by omega), mul_one, Pi.mulSingle_eq_same, ZMod.val_zero, if_pos (by omega)]
      · have hv1 : 1 ≤ i.val := by
          rcases Nat.eq_zero_or_pos i.val with h | h
          · exact absurd ((ZMod.val_eq_zero i).mp h) hi
          · exact h
        have hv : (i - 1 : ZMod q).val = i.val - 1 := by
          have : (i - 1 : ZMod q) = ((i.val - 1 : ℕ) : ZMod q) := by
            rw [Nat.cast_sub hv1, ZMod.natCast_zmod_val]; push_cast; ring
          rw [this, ZMod.val_natCast, Nat.mod_eq_of_lt (by have := ZMod.val_lt i; omega)]
        rw [hv, Pi.mulSingle_eq_of_ne hi, one_mul]
        by_cases hlt : i.val < t + 1
        · rw [if_pos (by omega), if_pos hlt]
        · rw [if_neg (by omega), if_neg hlt]
    · simp only [mul_right, r_mul_r]; push_cast; ring_nf

theorem wT_pow_q (hq : 2 ≤ q) :
    (⟨Pi.mulSingle 0 (sr 1), r 1⟩ : Wreath α q) ^ q = (inl (fun _ => sr 1) : Wreath α q) := by
  rw [wT_pow hq q le_rfl]
  ext i
  · simp [ZMod.val_lt i]
  · simp [ZMod.natCast_self, r_zero]

theorem shift_single (j : ZMod q) (hj : j + 1 ≠ 0) (x : DihedralGroup α) :
    (⟨Pi.mulSingle 0 (sr 1), r 1⟩ : Wreath α q) * (inl (Pi.mulSingle j x) : Wreath α q) *
      (⟨Pi.mulSingle 0 (sr 1), r 1⟩ : Wreath α q)⁻¹ = (inl (Pi.mulSingle (j + 1) x) : Wreath α q) := by
  rw [mk_eq_inl_mul_inr]
  have e1 : ∀ a b c : Wreath α q, a * b * c * (a * b)⁻¹ = a * (b * c * b⁻¹) * a⁻¹ := by
    intro a b c; group
  rw [e1, ← map_inv (inr : DihedralGroup q →* Wreath α q) (r 1), ← inl_aut,
    ← map_inv (inl : (ZMod q → DihedralGroup α) →* Wreath α q), ← map_mul, ← map_mul]
  congr 1
  funext i
  simp only [Pi.mul_apply, wreathAct_apply, dihedralPerm_inv_r, Pi.inv_apply]
  by_cases hi : i = 0
  · subst hi
    have : (0 - 1 : ZMod q) ≠ j := by intro h; apply hj; rw [← h]; ring
    rw [Pi.mulSingle_eq_same, Pi.mulSingle_eq_of_ne this, mul_one, inv_sr, sr_mul_self,
      Pi.mulSingle_eq_of_ne (Ne.symm hj)]
  · rw [Pi.mulSingle_eq_of_ne hi, one_mul, inv_one, mul_one]
    by_cases hij : i = j + 1
    · subst hij; rw [show j + 1 - 1 = j by ring, Pi.mulSingle_eq_same, Pi.mulSingle_eq_same]
    · have : i - 1 ≠ j := by intro h; apply hij; rw [← h]; ring
      rw [Pi.mulSingle_eq_of_ne this, Pi.mulSingle_eq_of_ne hij]

/-- Every element of D_{2α} ≀ D_{2q} lies in a subgroup containing wN, wM, wK (q, α ≥ 3, α odd). -/
theorem wreath_eq_top (hq : 3 ≤ q) (hα : 3 ≤ α) (hodd : α % 2 = 1) (H : Subgroup (Wreath α q))
    (hN : wN α q ∈ H) (hM : wM α q ∈ H) (hK : wK α q ∈ H) : H = ⊤ := by
  set wT : Wreath α q := ⟨Pi.mulSingle 0 (sr 1), r 1⟩ with hwT
  have hT : wT ∈ H := by rw [hwT, ← wN_mul_wM]; exact H.mul_mem hN hM
  have hTq : (inl (fun _ => sr 1) : Wreath α q) ∈ H := by rw [← wT_pow_q (by omega)]; exact H.pow_mem hT q
  -- block 0
  set K : Subgroup (DihedralGroup α) :=
    H.comap ((SemidirectProduct.inl : (ZMod q → DihedralGroup α) →* Wreath α q).comp
      (MonoidHom.mulSingle (fun _ : ZMod q => DihedralGroup α) 0)) with hKdef
  have hK2 : sr 2 ∈ K := hK
  have hK0 : sr 0 ∈ K := by
    show (inl (Pi.mulSingle 0 (sr 0)) : Wreath α q) ∈ H
    have e : (inl (fun _ : ZMod q => (sr 1 : DihedralGroup α)) : Wreath α q) * wK α q *
        (inl (fun _ : ZMod q => (sr 1 : DihedralGroup α)) : Wreath α q)⁻¹ =
        (inl (Pi.mulSingle 0 (sr 0)) : Wreath α q) := by
      rw [wK, mk_eq_inl_mul_inr, map_one, mul_one, ← map_inv, ← map_mul, ← map_mul]
      congr 1
      funext i
      simp only [Pi.mul_apply, Pi.inv_apply, inv_sr]
      by_cases hi : i = 0
      · subst hi; rw [Pi.mulSingle_eq_same, Pi.mulSingle_eq_same, sr_mul_sr, r_mul_sr]; ring_nf
      · rw [Pi.mulSingle_eq_of_ne hi, Pi.mulSingle_eq_of_ne hi, mul_one, sr_mul_self]
    rw [← e]; exact H.mul_mem (H.mul_mem hTq hK) (H.inv_mem hTq)
  have hKtop := dihedral_eq_top_of_sr hodd K hK0 hK2
  have hsingle0 : ∀ x : DihedralGroup α, (inl (Pi.mulSingle (0 : ZMod q) x) : Wreath α q) ∈ H := by
    intro x
    have : x ∈ K := by rw [hKtop]; trivial
    exact this
  have hsingle : ∀ (t : ℕ), t < q → ∀ x : DihedralGroup α,
      (inl (Pi.mulSingle (t : ZMod q) x) : Wreath α q) ∈ H := by
    intro t
    induction t with
    | zero => intro _ x; rw [Nat.cast_zero]; exact hsingle0 x
    | succ t ih =>
      intro ht x
      have hne : (t : ZMod q) + 1 ≠ 0 := by
        have := natCast_ne_zero_of_lt (M := q) (a := t + 1) (Nat.succ_pos t) ht
        push_cast at this; exact this
      have := shift_single (t : ZMod q) hne x
      push_cast
      rw [← this]
      exact H.mul_mem (H.mul_mem hT (ih (by omega) x)) (H.inv_mem hT)
  have hbase : ∀ f : ZMod q → DihedralGroup α, inl f ∈ H := by
    intro f
    have : f ∈ H.comap (SemidirectProduct.inl : (ZMod q → DihedralGroup α) →* Wreath α q) := by
      apply Subgroup.pi_mem_of_mulSingle_mem
      intro i
      show (inl (Pi.mulSingle i (f i)) : Wreath α q) ∈ H
      have := hsingle i.val (ZMod.val_lt i) (f i)
      rwa [ZMod.natCast_zmod_val] at this
    exact this
  -- top
  have hinr : ∀ d : DihedralGroup q, inr d ∈ H := by
    set K' : Subgroup (DihedralGroup q) :=
      H.comap (SemidirectProduct.inr : DihedralGroup q →* Wreath α q) with hK'
    have h1 : sr 1 ∈ K' := by
      show inr (sr 1) ∈ H
      have : (inr (sr 1) : Wreath α q) = (inl (wN α q).left)⁻¹ * wN α q := by
        rw [← inl_left_mul_inr_right (wN α q)]; simp [wN]
      rw [this]; exact H.mul_mem (H.inv_mem (hbase _)) hN
    have h2 : sr 2 ∈ K' := by
      show inr (sr 2) ∈ H
      have : (inr (sr 2) : Wreath α q) = (inl (wM α q).left)⁻¹ * wM α q := by
        rw [← inl_left_mul_inr_right (wM α q)]; simp [wM]
      rw [this]; exact H.mul_mem (H.inv_mem (hbase _)) hM
    have := dihedral_eq_top_of_sr12 K' h1 h2
    intro d
    have hd : d ∈ K' := by rw [this]; trivial
    exact hd
  rw [eq_top_iff]
  intro w _
  rw [← inl_left_mul_inr_right w]
  exact H.mul_mem (hbase _) (hinr _)

end iso

end Riemann.Deep.LeanPrefix

