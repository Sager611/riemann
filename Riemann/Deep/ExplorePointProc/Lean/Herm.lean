namespace PPLean

/-- Σ_k L[k] w^k (Horner). -/
noncomputable def horner : List ℚ → ℝ → ℝ
  | [], _ => 0
  | a :: L, w => (a : ℝ) + w * horner L w

lemma horner_cons_zero (a : ℚ) (L : List ℚ) : horner (a :: L) 0 = (a : ℝ) := by
  simp [horner]

