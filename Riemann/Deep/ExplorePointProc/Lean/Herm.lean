/-- cert_aug.py l.43–46: p(0) > 0 and (exact Sturm sequence, python-flint fmpq_poly) no root of p in (0, ∞). -/
def CertP : Prop := ∀ w : ℝ, 0 ≤ w → 0 < horner pcoef w

/-- l.47–52: q(w0) < 0 and (exact Sturm) no root of q in (w0, ∞), w0 = 2·(314159265/10⁸)·s²U², U = 288/125. -/
def CertQ : Prop :=
  ∀ w : ℝ, 2 * (314159265 / 100000000) * (11 / 10) ^ 2 * (288 / 125) ^ 2 ≤ w → horner qcoef w < 0

/-- The Hermite–Gaussian identities: f(α) = p(κα²)G(α), f^(u) = s q(κ'u²)G'(u), with κ = 2π/s² ≥ 0,
G(α) = e^{−πα²/s²} > 0, κ' = 2πs² ≥ 2·3.14159265·s² (π > 3.14159265), G'(u) = e^{−πs²u²} > 0, G'(0) = 1
(the Fourier transform of H_{2n}(√(2π)α/s)e^{−πα²/s²} is s(−1)^n H_{2n}(√(2π)su)e^{−πs²u²}). -/
def HermRep (f fh : ℝ → ℝ) : Prop :=
  (∃ κ : ℝ, 0 ≤ κ ∧ ∃ G : ℝ → ℝ, (∀ α, 0 < G α) ∧ ∀ α, f α = horner pcoef (κ * α ^ 2) * G α) ∧
  (∃ κ' : ℝ, 2 * (314159265 / 100000000) * (11 / 10) ^ 2 ≤ κ' ∧ ∃ G' : ℝ → ℝ, (∀ u, 0 < G' u) ∧
    G' 0 = 1 ∧ ∀ u, fh u = 11 / 10 * horner qcoef (κ' * u ^ 2) * G' u)

/-- f > 0 (on all of ℝ, in particular on [0, ∞)). -/
lemma pos_of_rep {f fh : ℝ → ℝ} (hrep : HermRep f fh) (hP : CertP) (α : ℝ) : 0 < f α := by
  obtain ⟨⟨κ, hκ, G, hG, hf⟩, -⟩ := hrep
  rw [hf α]
  exact mul_pos (hP _ (by positivity)) (hG α)

/-- f^ < 0 on [U, ∞). -/
lemma neg_of_rep {f fh : ℝ → ℝ} (hrep : HermRep f fh) (hQ : CertQ) (u : ℝ) (hu : 288 / 125 ≤ u) :
    fh u < 0 := by
  obtain ⟨-, ⟨κ', hκ', G', hG', -, hfh⟩⟩ := hrep
  have hk : 0 ≤ κ' := le_trans (by norm_num) hκ'
  have hu2 : (288 / 125 : ℝ) ^ 2 ≤ u ^ 2 := by
    rw [sq, sq]
    exact mul_le_mul hu hu (by norm_num) (by linarith)
  have hw : 2 * (314159265 / 100000000) * (11 / 10) ^ 2 * (288 / 125) ^ 2 ≤ κ' * u ^ 2 :=
    le_trans (mul_le_mul_of_nonneg_right hκ' (by positivity)) (mul_le_mul_of_nonneg_left hu2 hk)
  have hq := hQ _ hw
  rw [hfh u]
  exact mul_neg_of_neg_of_pos (by linarith) (hG' u)

/-- f^(0) = s·q(0) = 1.0010999999999997… ≤ 1.0011 (exact rational arithmetic). -/
lemma fh0_of_rep {f fh : ℝ → ℝ} (hrep : HermRep f fh) : fh 0 ≤ 10011 / 10000 := by
  obtain ⟨-, ⟨κ', -, G', -, hG0, hfh⟩⟩ := hrep
  rw [hfh 0, hG0, show κ' * (0 : ℝ) ^ 2 = 0 by ring]
  unfold qcoef
  rw [horner_cons_zero]
  norm_num

