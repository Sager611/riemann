import Mathlib.Data.ZMod.Defs
import Mathlib.Data.List.Permutation

/-!
# Sun's conjectures on finite abelian groups: 1309.1679 Conj. 3.2, 3.4(i); OEIS A228766 (general form)

Each conjecture is stated as a `Prop` (`Conj_*`) and refuted (`not_conj_*`) by one explicit
instance; the finite check runs over `List.permutations'` (`decide`). Sources and fidelity: `../LEAN.md`.
-/

namespace SunLean

/-- The 2-torsion subgroup `{g | 2 ^ k • g = 0 for some k}` (for a finite abelian group: its Sylow
2-subgroup) is cyclic, i.e. generated by one of its elements. -/
def Syl2Cyclic (G : Type) [AddCommGroup G] : Prop :=
  ∃ g : G, (∃ k : ℕ, 2 ^ k • g = 0) ∧ ∀ h : G, (∃ k : ℕ, 2 ^ k • h = 0) → ∃ m : ℕ, h = m • g

/-- Z.-W. Sun, arXiv 1309.1679 v9, Conjecture 3.2 (TeX label `Conj3.3`, l. 512-516), with the
condition "the Sylow 2-subgroup of `G` is cyclic" as a parameter `syl`:
`a = [a_1, …, a_n]` distinct; `n ∤ |G|`, or `n` even and `syl G`; then some permutation
`b = [b_1, …, b_n]` of `a` with `b_1 = a_1` has the `n - 1` differences `b_i - b_(i+1)` pairwise distinct. -/
def Conj_3_2_with (syl : (G : Type) → [AddCommGroup G] → Prop) : Prop :=
  ∀ (G : Type) [AddCommGroup G] [Fintype G] (a : List G), a.Nodup →
    (¬ a.length ∣ Fintype.card G ∨ (Even a.length ∧ syl G)) →
    ∃ b : List G, b.Perm a ∧ b.head? = a.head? ∧ (List.zipWith (· - ·) b b.tail).Nodup

/-- Conjecture 3.2 with the Sylow condition spelled out (`Syl2Cyclic`). -/
def Conj_3_2 : Prop := Conj_3_2_with Syl2Cyclic

/-- `G = ℤ/6`, `(a_1, …, a_4) = (0, 1, 3, 5)`, `4 ∤ 6`: for every reading of the Sylow condition. -/
theorem not_conj_3_2_with (syl : (G : Type) → [AddCommGroup G] → Prop) : ¬ Conj_3_2_with syl := by
  intro h
  obtain ⟨b, hp, hh, hd⟩ :=
    h (ZMod 6) [0, 1, 3, 5] (by decide) (Or.inl (by rw [ZMod.card]; decide))
  have key : ∀ b ∈ ([0, 1, 3, 5] : List (ZMod 6)).permutations', b.head? = some 0 →
      ¬ (List.zipWith (· - ·) b b.tail).Nodup := by decide
  exact key b (List.mem_permutations'.2 hp) hh hd

theorem not_conj_3_2 : ¬ Conj_3_2 := not_conj_3_2_with Syl2Cyclic

/-- Z.-W. Sun, arXiv 1309.1679 v9, Conjecture 3.4(i) (TeX label `Conj3.5`, l. 541-548):
`A` a finite subset of an abelian group `G`, `|A| = n > 3`, `G` finite with `3 ∤ |G|`; then some
numbering `a_1, …, a_n` of all elements of `A` has the `n` sums `a_i + 2 a_(i+1)` (indices mod `n`)
pairwise distinct. A numbering is a duplicate-free list with the same elements as `A`. -/
def Conj_3_4_i : Prop :=
  ∀ (G : Type) [AddCommGroup G] [Fintype G] (A : Finset G), 3 < A.card → ¬ 3 ∣ Fintype.card G →
    ∃ l : List G, l.Nodup ∧ (∀ x, x ∈ l ↔ x ∈ A) ∧
      (List.zipWith (fun x y => x + 2 • y) l (l.rotate 1)).Nodup

/-- `G = ℤ/7`, `A = {0, 1, 2, 3, 4}`: all 120 numberings repeat a sum. -/
theorem not_conj_3_4_i : ¬ Conj_3_4_i := by
  intro h
  have hA : ([0, 1, 2, 3, 4] : List (ZMod 7)).Nodup := by decide
  obtain ⟨l, hl, hmem, hs⟩ := h (ZMod 7) ([0, 1, 2, 3, 4] : List (ZMod 7)).toFinset
    (by rw [List.toFinset_card_of_nodup hA]; decide) (by rw [ZMod.card]; decide)
  have hp : l.Perm [0, 1, 2, 3, 4] :=
    (List.perm_ext_iff_of_nodup hl hA).2 (fun x => (hmem x).trans List.mem_toFinset)
  have key : ∀ l ∈ ([0, 1, 2, 3, 4] : List (ZMod 7)).permutations',
      ¬ (List.zipWith (fun x y => x + 2 • y) l (l.rotate 1)).Nodup := by decide +kernel
  exact key l (List.mem_permutations'.2 hp) hs

/-- Z.-W. Sun, OEIS A228766, comment ("In general, …"): `n > 2` distinct elements `a_1, …, a_n` of a
finite abelian group `G` with `n` odd or `n ∤ |G|`; then some circular permutation `b_1, …, b_n` of
them has the `n` sums `b_1 + b_2, …, b_(n-1) + b_n, b_n + b_1` pairwise distinct. -/
def Conj_A228766 : Prop :=
  ∀ (G : Type) [AddCommGroup G] [Fintype G] (a : List G), 2 < a.length → a.Nodup →
    (a.length % 2 = 1 ∨ ¬ a.length ∣ Fintype.card G) →
    ∃ b : List G, b.Perm a ∧ (List.zipWith (· + ·) b (b.rotate 1)).Nodup

/-- `G = ℤ/6`, `{a_1, …, a_4} = {0, 1, 3, 4}`, `4 ∤ 6`. -/
theorem not_conj_A228766 : ¬ Conj_A228766 := by
  intro h
  obtain ⟨b, hp, hs⟩ :=
    h (ZMod 6) [0, 1, 3, 4] (by decide) (by decide) (Or.inr (by rw [ZMod.card]; decide))
  have key : ∀ b ∈ ([0, 1, 3, 4] : List (ZMod 6)).permutations',
      ¬ (List.zipWith (· + ·) b (b.rotate 1)).Nodup := by decide
  exact key b (List.mem_permutations'.2 hp) hs

end SunLean

#print axioms SunLean.not_conj_3_2
#print axioms SunLean.not_conj_3_4_i
#print axioms SunLean.not_conj_A228766
