theorem chkB_append : ∀ (cs ds : List (ℕ × ℕ × ℤ × ℤ)) (x : ℕ) (mL jL : ℚ) (y R : ℕ), cs ≠ [] →
    chkB C x mL jL cs y = true → chkB C y (muQ5 C y) (jtQ C y) ds R = true → chkB C x mL jL (cs ++ ds) R = true
  | [], _, _, _, _, _, _, h, _, _ => absurd rfl h
  | [c], ds, x, mL, jL, y, R, _, h1, h2 => by
    simp only [chkB, Bool.and_eq_true, decide_eq_true_eq] at h1
    obtain ⟨⟨hx, hc⟩, hy⟩ := h1
    simp only [List.cons_append, List.nil_append, chkB, Bool.and_eq_true, decide_eq_true_eq]
    rw [← hy] at h2
    exact ⟨⟨hx, hc⟩, h2⟩
  | c :: c' :: cs, ds, x, mL, jL, y, R, _, h1, h2 => by
    simp only [chkB, Bool.and_eq_true, decide_eq_true_eq] at h1
    obtain ⟨⟨hx, hc⟩, hrest⟩ := h1
    have := chkB_append (c' :: cs) ds c.2.1 (muQ5 C c.2.1) (jtQ C c.2.1) y R
      (List.cons_ne_nil _ _) (by simpa only [chkB, Bool.and_eq_true, decide_eq_true_eq] using hrest) h2
    simp only [List.cons_append, chkB, Bool.and_eq_true, decide_eq_true_eq] at this ⊢
    exact ⟨⟨hx, hc⟩, this⟩

