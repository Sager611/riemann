/-- CertB1: Arb-checked (logs/verify_t1_0595.log, PASS, min ≥ 0.000239): P ≥ |α|·1[α ≤ 1] on
[0, 1/(2h)] = [0, 300/119] for h = 119/600. -/
def CertB1 : Prop :=
  ∀ α : ℝ, 0 ≤ α → α ≤ 300 / 119 → (if α ≤ 1 then α else 0) ≤ Pfin (119 / 600) certB1 α

lemma certB1_ge : ∀ x ∈ certB1, -1000000000000 ≤ x := by decide +kernel
lemma certB1_core : ∀ i < 3 - 1, certB1.getD i 0 = -1000000000000 := by decide +kernel

theorem theoremB1 (hcert : CertB1) {θ lam : ℝ} (hθ0 : 0 ≤ θ) (hθ : θ ≤ 1)
    (hlam : lam ≤ 119 / 200) {f : ℝ → ℝ} (hf : Admissible lam f) : J θ f ≤ 1 := by
  have hf' : Admissible (119 / 200) f := hf.mono hlam
  have h1 : J 1 f ≤ 1 := by
    refine weak_duality (h := 119 / 600) (k0 := 3) (η := etaOf certB1) (by norm_num) (by norm_num)
      (summable_etaOf _) (etaOf_core certB1_core) (fun k _ => etaOf_ge certB1_ge k) (by norm_num)
      (by norm_num) (fun α h0 h1 => ?_) hf'
    rw [P_etaOf]
    exact hcert α h0 (by linarith [show (1 : ℝ) / (2 * (119 / 600)) = 300 / 119 by norm_num])
  exact (J_mono hf'.nonneg hf'.contDiff.continuous hθ0 hθ).trans h1


