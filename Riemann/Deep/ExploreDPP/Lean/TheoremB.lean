/-! ## Finite certificates -/

/-- η_k = L[k-1] / 10^12 for 1 ≤ k ≤ length L, else 0. -/
def etaOf (L : List ℤ) (k : ℕ) : ℝ := if 1 ≤ k then ((L.getD (k - 1) 0 : ℤ) : ℝ) / 10 ^ 12 else 0

/-- P with the finite sum Σ_{k=1}^{K}, K = length L. -/
def Pfin (h : ℝ) (L : List ℤ) (α : ℝ) : ℝ :=
  (1 - h) + 2 * h * ∑ n ∈ Finset.range L.length,
    etaOf L (n + 1) * Real.cos (2 * π * α * ((n + 1) * h))

lemma P_etaOf (h : ℝ) (L : List ℤ) (α : ℝ) : P h (etaOf L) α = Pfin h L α := by
  unfold P Pfin
  congr 2
  apply tsum_eq_sum
  intro n hn
  simp only [Finset.mem_range, not_lt] at hn
  simp only [etaOf, show n + 1 - 1 = n by omega, List.getD_eq_default _ _ hn]
  simp

lemma summable_etaOf (L : List ℤ) : Summable (etaOf L) := by
  apply summable_of_ne_finset_zero (s := Finset.range (L.length + 1))
  intro k hk
  simp only [Finset.mem_range, not_lt] at hk
  have : L.length ≤ k - 1 := by omega
  simp only [etaOf, List.getD_eq_default _ _ this]
  simp

lemma getD_ge {L : List ℤ} {c : ℤ} (hc : c ≤ 0) (hL : ∀ x ∈ L, c ≤ x) (i : ℕ) :
    c ≤ L.getD i 0 := by
  rcases lt_or_ge i L.length with hi | hi
  · rw [List.getD_eq_getElem _ _ hi]; exact hL _ (List.getElem_mem hi)
  · rw [List.getD_eq_default _ _ hi]; exact hc

lemma etaOf_ge {L : List ℤ} (hL : ∀ x ∈ L, -1000000000000 ≤ x) (k : ℕ) : -1 ≤ etaOf L k := by
  unfold etaOf
  split_ifs
  · have h1 : ((-1000000000000 : ℤ) : ℝ) ≤ ((L.getD (k - 1) 0 : ℤ) : ℝ) := by
      exact_mod_cast getD_ge (by norm_num) hL (k - 1)
    rw [le_div_iff₀ (by norm_num)]
    push_cast at h1
    linarith
  · norm_num

lemma etaOf_core {L : List ℤ} {k0 : ℕ} (hL : ∀ i < k0 - 1, L.getD i 0 = -1000000000000)
    (k : ℕ) (hk1 : 1 ≤ k) (hk : k < k0) : etaOf L k = -1 := by
  unfold etaOf
  split_ifs
  rw [hL (k - 1) (by omega)]; norm_num

