/-- CertB: the Arb-checked inequality (verify_dual.py, logs/verify_t47exact_0775.log, PASS,
min ≥ 0.000204): P ≥ |α|·1[α ≤ θ] on [0, 1/(2h)] = [0, 140/31] for θ = 4/7, h = 31/280. -/
def CertB : Prop :=
  ∀ α : ℝ, 0 ≤ α → α ≤ 140 / 31 → (if α ≤ 4 / 7 then α else 0) ≤ Pfin (31 / 280) certB α

lemma certB_ge : ∀ x ∈ certB, -1000000000000 ≤ x := by decide +kernel
lemma certB_core : ∀ i < 7 - 1, certB.getD i 0 = -1000000000000 := by decide +kernel

/-- Theorem B (i). Under CertB: for 0 ≤ θ ≤ 4/7 and λ ≤ 0.775 every admissible f has
J_θ(f) ≤ 1 = f^(0). -/
theorem theoremB (hcert : CertB) {θ lam : ℝ} (hθ0 : 0 ≤ θ) (hθ : θ ≤ 4 / 7)
    (hlam : lam ≤ 31 / 40) {f : ℝ → ℝ} (hf : Admissible lam f) : J θ f ≤ 1 := by
  have hf' : Admissible (31 / 40) f := hf.mono hlam
  have h1 : J (4 / 7) f ≤ 1 := by
    refine weak_duality (h := 31 / 280) (k0 := 7) (η := etaOf certB) (by norm_num) (by norm_num)
      (summable_etaOf _) (etaOf_core certB_core) (fun k _ => etaOf_ge certB_ge k) (by norm_num)
      (by norm_num) (fun α h0 h1 => ?_) hf'
    rw [P_etaOf]
    exact hcert α h0 (by linarith [show (1 : ℝ) / (2 * (31 / 280)) = 140 / 31 by norm_num])
  exact (J_mono hf'.nonneg hf'.contDiff.continuous hθ0 hθ).trans h1

/-- Under CertB, the hypotheses of Lamzouri's Thm Main2 cannot be met for any λ ≤ 0.775. -/
theorem not_main2Hyp (hcert : CertB) {θ lam : ℝ} (hlam : lam ≤ 31 / 40) (f : ℝ → ℝ) :
    ¬ Main2Hyp θ lam f := by
  rintro ⟨hθ1, hθ2, -, -, hf, hJ⟩
  have := theoremB hcert (by linarith) hθ2.le hlam hf
  linarith

/-- Under CertB: for 0 ≤ θ ≤ 4/7 and λ ≤ 0.775 no f satisfies the f-hypotheses of Thm Main2,
J_θ(f) > 1 included. -/
theorem no_main2Kernel (hcert : CertB) {θ lam : ℝ} (hθ0 : 0 ≤ θ) (hθ : θ ≤ 4 / 7)
    (hlam : lam ≤ 31 / 40) (f : ℝ → ℝ) : ¬ Main2Kernel θ lam f :=
  fun ⟨hf, hJ⟩ => absurd (theoremB hcert hθ0 hθ hlam hf) (not_le.mpr hJ)

