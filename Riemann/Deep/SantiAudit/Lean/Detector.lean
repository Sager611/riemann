/-
E1Lean.Detector — the detector polynomials of E1.md §4: SL §6 Chebyshev family Q and truncated-sinh P,
with the frozen EXP-010 data (params_exp010.json, set ν = 999/10000), and their exact admissibility
(Q(0) = 1, Q(1) = 0, Q(y) + Q(1 − y) ≡ 1, P(0) = 0, P(1) = 1), proved for every parameter list.
-/
import Riemann.Deep.SantiAudit.Lean.Defs

namespace E1Lean

/-- Chebyshev polynomials of the first kind: T₀ = 1, T₁ = x, T_{n+2} = 2x T_{n+1} − T_n. -/
noncomputable def cheb : ℕ → ℝ → ℝ
  | 0, _ => 1
  | 1, x => x
  | n + 2, x => 2 * x * cheb (n + 1) x - cheb n x

theorem cheb_one : ∀ n, cheb n 1 = 1
  | 0 => by simp [cheb]
  | 1 => by simp [cheb]
  | n + 2 => by rw [cheb, cheb_one (n + 1), cheb_one n]; norm_num

theorem cheb_neg (x : ℝ) : ∀ n, cheb n (-x) = (-1) ^ n * cheb n x
  | 0 => by simp [cheb]
  | 1 => by simp [cheb]
  | n + 2 => by rw [cheb, cheb, cheb_neg x (n + 1), cheb_neg x n]; ring

theorem cheb_odd (x : ℝ) (j : ℕ) : cheb (2 * j + 1) (-x) = -cheb (2 * j + 1) x := by
  rw [cheb_neg, (odd_two_mul_add_one j).neg_one_pow]; ring

theorem isPoly_cheb : ∀ n, IsPoly (fun x => cheb n x)
  | 0 => by simpa [cheb] using IsPoly.const 1
  | 1 => by simpa [cheb] using IsPoly.id
  | n + 2 => by
    have e : (fun x => cheb (n + 2) x) = (fun x => 2 * x * cheb (n + 1) x - cheb n x) := by
      funext x; simp [cheb]
    rw [e]
    exact ((IsPoly.smul 2 IsPoly.id).mul (isPoly_cheb (n + 1))).sub (isPoly_cheb n)

/-- Σ_{i} a_i (T_{2(j+i)+1}(1 − 2y) − (1 − 2y)) over the list a, indices from j. -/
noncomputable def qsum : List ℝ → ℕ → ℝ → ℝ
  | [], _, _ => 0
  | a :: as, j, y => a * (cheb (2 * j + 1) (1 - 2 * y) - (1 - 2 * y)) + qsum as (j + 1) y

/-- SL §6: Q(y) = 1 − y + Σ_{j=1..K} x_j (T_{2j+1}(1 − 2y) − (1 − 2y)). -/
noncomputable def Qfam (xs : List ℝ) (y : ℝ) : ℝ := 1 - y + qsum xs 1 y

theorem qsum_zero : ∀ (xs : List ℝ) (j : ℕ), qsum xs j 0 = 0
  | [], _ => by simp [qsum]
  | a :: as, j => by simp [qsum, cheb_one, qsum_zero as (j + 1)]

theorem qsum_symm (y : ℝ) : ∀ (xs : List ℝ) (j : ℕ), qsum xs j (1 - y) = -qsum xs j y
  | [], _ => by simp [qsum]
  | a :: as, j => by
    have e : (1 - 2 * (1 - y)) = -(1 - 2 * y) := by ring
    rw [qsum, qsum, e, cheb_odd, qsum_symm y as (j + 1)]; ring

theorem isPoly_qsum : ∀ (xs : List ℝ) (j : ℕ), IsPoly (fun y => qsum xs j y)
  | [], _ => by simpa [qsum] using IsPoly.const 0
  | a :: as, j => by
    have hl : IsPoly (fun y : ℝ => 1 - 2 * y) := (IsPoly.const 1).sub (IsPoly.smul 2 IsPoly.id)
    exact (IsPoly.smul a (((isPoly_cheb (2 * j + 1)).comp hl).sub hl)).add (isPoly_qsum as (j + 1))

theorem Qfam_zero (xs : List ℝ) : Qfam xs 0 = 1 := by simp [Qfam, qsum_zero]

theorem Qfam_symm (xs : List ℝ) (y : ℝ) : Qfam xs y + Qfam xs (1 - y) = 1 := by
  simp only [Qfam, qsum_symm]; ring

theorem Qfam_one (xs : List ℝ) : Qfam xs 1 = 0 := by
  have h := Qfam_symm xs 0
  rw [Qfam_zero, sub_zero] at h; linarith

theorem isPoly_Qfam (xs : List ℝ) : IsPoly (Qfam xs) :=
  ((IsPoly.const 1).sub IsPoly.id).add (isPoly_qsum xs 1)

/-- S(u) = Σ_{i=0..6} u^{2i+1}/(2i+1)! (params_exp010.json, P_definition). -/
noncomputable def Sfun (u : ℝ) : ℝ :=
  u + u ^ 3 / 6 + u ^ 5 / 120 + u ^ 7 / 5040 + u ^ 9 / 362880 + u ^ 11 / 39916800 + u ^ 13 / 6227020800

/-- P(x) = S(r x)/S(r). -/
noncomputable def Pfam (r x : ℝ) : ℝ := Sfun (r * x) / Sfun r

theorem Sfun_pos {u : ℝ} (hu : 0 < u) : 0 < Sfun u := by unfold Sfun; positivity

theorem Pfam_zero (r : ℝ) : Pfam r 0 = 0 := by simp [Pfam, Sfun]

theorem Pfam_one {r : ℝ} (hr : 0 < r) : Pfam r 1 = 1 := by
  simp only [Pfam, mul_one]; exact div_self (Sfun_pos hr).ne'

theorem isPoly_Sfun : IsPoly Sfun := by
  have m : ∀ (n : ℕ) (d : ℝ), IsPoly (fun u : ℝ => u ^ n / d) := fun n d => by
    have h := IsPoly.smul d⁻¹ (IsPoly.pow IsPoly.id n)
    simpa [div_eq_inv_mul] using h
  exact ((((((IsPoly.id.add (m 3 6)).add (m 5 120)).add (m 7 5040)).add (m 9 362880)).add
    (m 11 39916800)).add (m 13 6227020800))

theorem isPoly_Pfam (r : ℝ) : IsPoly (Pfam r) := by
  have h := IsPoly.smul (Sfun r)⁻¹ (isPoly_Sfun.comp (IsPoly.smul r IsPoly.id))
  have e : Pfam r = fun x => (Sfun r)⁻¹ * Sfun (r * x) := by funext x; simp [Pfam, div_eq_inv_mul]
  rw [e]; exact h

