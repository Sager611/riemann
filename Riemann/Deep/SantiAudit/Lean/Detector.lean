/-- The detector Q of E1.md §4 (degree 201): Q₁ = Qfam xs₁. -/
noncomputable def Q₁ : ℝ → ℝ := Qfam xs₁

/-- The detector P of E1.md §4 (degree 13): P₁(x) = S(r_P x)/S(r_P), r_P = 7707/10000. -/
noncomputable def P₁ : ℝ → ℝ := Pfam (7707 / 10000)

/-- Detector admissibility (E1.md §3 last row; SL Thm 1.2, 1.3 hypotheses), exact. -/
theorem detector_admissible : IsPoly P₁ ∧ IsPoly Q₁ ∧ P₁ 0 = 0 ∧ P₁ 1 = 1 ∧ Q₁ 0 = 1 ∧ Q₁ 1 = 0 ∧
    ∀ y, Q₁ y + Q₁ (1 - y) = 1 :=
  ⟨isPoly_Pfam _, isPoly_Qfam _, Pfam_zero _, Pfam_one (by norm_num), Qfam_zero _, Qfam_one _, Qfam_symm _⟩

