import Riemann.Deep.FirstZero.Next
import Riemann.Deep.FirstZero.Simple
import Riemann.Deep.FirstZero.SimpleNextZ2C2
import Riemann.Deep.FirstZero.SimpleNextZ3C3
import Riemann.Deep.FirstZero.SimpleNextZ4C4
import Riemann.Deep.FirstZero.SimpleNextZ5C4

/-!
# The 2nd–5th zeta zeros are simple

For each certified zero 1/2 + iγ of Next.lean (γ ≈ 21.02, 25.01, 30.42, 32.94) a box
[1/4, 2] × [a, b] around it (a, b = 20.5, 21.5 / 24.2, 25.8 / 29.9, 30.9 / 32.4, 33.4) carries a
certified argument-principle bound: the arg change of ζ around the box is < 4π, so the zeros in
the box have total order < 2 (SimpleNextLib.simple_of_box). The certified zero is in the box, so
its order is 1, ζ'(1/2 + iγ) ≠ 0, and it is the only zero of ζ in the critical strip with
a ≤ Im s ≤ b.

Same route as Simple.lean (a certified count forces order 1), but with an off-axis box (no pole,
no conjugate folding), so the left edge only needs certifying on [a, b] instead of [0, b].
Certificates: SimpleNextZ{2,3,4,5}C*.lean, generated by .scratch/simplenext/sngen.py
(83 Euler–Maclaurin Taylor-model pieces, 87 nodes, N ≤ 11).
-/

open Complex

namespace Fayed.FirstZero.SimpleNext

lemma pack {a b lo hi : ℝ}
    (hbox : ∀ t : ℝ, a < t → t < b → riemannZeta (1 / 2 + t * I) = 0 →
      analyticOrderAt riemannZeta (1 / 2 + t * I) = 1 ∧
        ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → a ≤ s.im → s.im ≤ b →
          s = 1 / 2 + t * I)
    (hz : ∃ t : ℝ, lo < t ∧ t < hi ∧ riemannZeta ((1 / 2 : ℂ) + t * Complex.I) = 0)
    (hlo : a ≤ lo) (hhi : hi ≤ b) :
    ∃ t : ℝ, lo < t ∧ t < hi ∧ riemannZeta (1 / 2 + t * I) = 0 ∧
      deriv riemannZeta (1 / 2 + t * I) ≠ 0 ∧ analyticOrderAt riemannZeta (1 / 2 + t * I) = 1 ∧
      ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → a ≤ s.im → s.im ≤ b →
        s = 1 / 2 + t * I := by
  obtain ⟨t, h1, h2, h0⟩ := hz
  obtain ⟨hord, hu⟩ := hbox t (by linarith) (by linarith) h0
  have hc1 : (1 / 2 + (t : ℂ) * I) ≠ 1 := by
    intro h; have := congrArg Complex.re h; norm_num at this
  exact ⟨t, h1, h2, h0, Simple.deriv_ne_zero_of_order_one
    (Zeta23.riemannZeta_analyticOnNhd_compl_one _ hc1) h0 hord, hord, hu⟩

end Fayed.FirstZero.SimpleNext

namespace Fayed.FirstZero
open SimpleNext SimpleNext.Cert

/-- **The second zeta zero is simple**, and the only zero in the strip with 20.5 ≤ Im s ≤ 21.5. -/
theorem second_zero_simple : ∃ t : ℝ, 21.018 < t ∧ t < 21.026 ∧
    riemannZeta (1 / 2 + t * I) = 0 ∧ deriv riemannZeta (1 / 2 + t * I) ≠ 0 ∧
    analyticOrderAt riemannZeta (1 / 2 + t * I) = 1 ∧
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 20.5 ≤ s.im → s.im ≤ 21.5 →
      s = 1 / 2 + t * I := by
  have h := pack simple_z2 second_zero (by norm_num) (by norm_num)
  norm_num at h ⊢
  exact h

/-- **The third zeta zero is simple**, and the only zero in the strip with 24.2 ≤ Im s ≤ 25.8. -/
theorem third_zero_simple : ∃ t : ℝ, 25.0069 < t ∧ t < 25.0149 ∧
    riemannZeta (1 / 2 + t * I) = 0 ∧ deriv riemannZeta (1 / 2 + t * I) ≠ 0 ∧
    analyticOrderAt riemannZeta (1 / 2 + t * I) = 1 ∧
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 24.2 ≤ s.im → s.im ≤ 25.8 →
      s = 1 / 2 + t * I := by
  have h := pack simple_z3 third_zero (by norm_num) (by norm_num)
  norm_num at h ⊢
  exact h

/-- **The fourth zeta zero is simple**, and the only zero in the strip with 29.9 ≤ Im s ≤ 30.9. -/
theorem fourth_zero_simple : ∃ t : ℝ, 30.4209 < t ∧ t < 30.4289 ∧
    riemannZeta (1 / 2 + t * I) = 0 ∧ deriv riemannZeta (1 / 2 + t * I) ≠ 0 ∧
    analyticOrderAt riemannZeta (1 / 2 + t * I) = 1 ∧
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 29.9 ≤ s.im → s.im ≤ 30.9 →
      s = 1 / 2 + t * I := by
  have h := pack simple_z4 fourth_zero (by norm_num) (by norm_num)
  norm_num at h ⊢
  exact h

/-- **The fifth zeta zero is simple**, and the only zero in the strip with 32.4 ≤ Im s ≤ 33.4. -/
theorem fifth_zero_simple : ∃ t : ℝ, 32.9311 < t ∧ t < 32.9391 ∧
    riemannZeta (1 / 2 + t * I) = 0 ∧ deriv riemannZeta (1 / 2 + t * I) ≠ 0 ∧
    analyticOrderAt riemannZeta (1 / 2 + t * I) = 1 ∧
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 32.4 ≤ s.im → s.im ≤ 33.4 →
      s = 1 / 2 + t * I := by
  have h := pack simple_z5 fifth_zero (by norm_num) (by norm_num)
  norm_num at h ⊢
  exact h

/-- **The first five zeros are simple**: five points 1/2 + i tᵢ on the critical line, one in each
of (14.13, 14.14), (21.018, 21.026), (25.0069, 25.0149), (30.4209, 30.4289), (32.9311, 32.9391),
with ζ = 0 and ζ' ≠ 0 at each. -/
theorem first_five_zeros_simple : ∃ t : Fin 5 → ℝ, StrictMono t ∧
    14.13 < t 0 ∧ t 0 < 14.14 ∧ 21.018 < t 1 ∧ t 1 < 21.026 ∧ 25.0069 < t 2 ∧ t 2 < 25.0149 ∧
    30.4209 < t 3 ∧ t 3 < 30.4289 ∧ 32.9311 < t 4 ∧ t 4 < 32.9391 ∧
    ∀ i, riemannZeta (1 / 2 + t i * I) = 0 ∧ deriv riemannZeta (1 / 2 + t i * I) ≠ 0 := by
  obtain ⟨t1, h1a, h1b, h1, d1⟩ := first_zero_simple
  obtain ⟨t2, h2a, h2b, h2, d2, -⟩ := second_zero_simple
  obtain ⟨t3, h3a, h3b, h3, d3, -⟩ := third_zero_simple
  obtain ⟨t4, h4a, h4b, h4, d4, -⟩ := fourth_zero_simple
  obtain ⟨t5, h5a, h5b, h5, d5, -⟩ := fifth_zero_simple
  refine ⟨![t1, t2, t3, t4, t5], ?_, h1a, h1b, h2a, h2b, h3a, h3b, h4a, h4b, h5a, h5b, ?_⟩
  · refine Fin.strictMono_iff_lt_succ.mpr fun i => ?_
    fin_cases i <;> simp <;> norm_num at * <;> linarith
  · intro i
    fin_cases i
    exacts [⟨h1, d1⟩, ⟨h2, d2⟩, ⟨h3, d3⟩, ⟨h4, d4⟩, ⟨h5, d5⟩]

end Fayed.FirstZero

