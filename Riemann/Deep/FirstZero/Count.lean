import Riemann.Deep.FirstZero.SimpleNext
import Riemann.Deep.FirstZero.CountG1C3
import Riemann.Deep.FirstZero.CountG2C3
import Riemann.Deep.FirstZero.CountG3C3
import Riemann.Deep.FirstZero.CountG4C4

/-!
# Exactly five zeta zeros up to height 33.4: N(33.4) = 5

Every zero ρ of ζ with 0 < Re ρ < 1 and 0 < Im ρ ≤ 33.4 is one of the five simple critical zeros
1/2 + iγ, γ ∈ (14.13, 14.14), (21.018, 21.026), (25.0069, 25.0149), (30.4209, 30.4289),
(32.9311, 32.9391).

Cover of (0, 33.4] by Im-ranges:
* (0, 15]: first_zero_simple_unique (Simple.lean);
* [20.5, 21.5], [24.2, 25.8], [29.9, 30.9], [32.4, 33.4]: the one-zero boxes of SimpleNext.lean;
* gaps [15, 20.5], [21.5, 24.2], [25.8, 29.9], [30.9, 32.4]: boxes [1/4, 2] × [a, b] with certified
  arg change < 2π, hence empty (CountLib.no_zero_of_box; certificates CountG{1,2,3,4}C*.lean,
  generated by .scratch/count/countgen.py on top of .scratch/simplenext/sngen.py). The part of the
  strip with Re ρ < 1/4 is covered by the reflection ρ ↦ 1 − conj ρ.
-/

open Complex

namespace Fayed.FirstZero.Count

lemma im_crit (t : ℝ) : ((1 / 2 : ℂ) + t * I).im = t := by simp

lemma re_crit (t : ℝ) : ((1 / 2 : ℂ) + t * I).re = 1 / 2 := by simp

end Fayed.FirstZero.Count

namespace Fayed.FirstZero
open Fayed.FirstZero.Count Fayed.FirstZero.Count.Cert

/-- **N(33.4) = 5, located**: every nontrivial zero ρ with 0 < Im ρ ≤ 33.4 has Im ρ in one of the
five certified intervals. -/
theorem zero_im_mem_five : ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 0 < s.im →
    s.im ≤ 33.4 →
    (14.13 < s.im ∧ s.im < 14.14) ∨ (21.018 < s.im ∧ s.im < 21.026) ∨
      (25.0069 < s.im ∧ s.im < 25.0149) ∨ (30.4209 < s.im ∧ s.im < 30.4289) ∨
      (32.9311 < s.im ∧ s.im < 32.9391) := by
  intro s hz h0 h1 hpos htop
  obtain ⟨t1, a1, b1, -, -, -, u1⟩ := first_zero_simple_unique
  obtain ⟨t2, a2, b2, -, -, -, u2⟩ := second_zero_simple
  obtain ⟨t3, a3, b3, -, -, -, u3⟩ := third_zero_simple
  obtain ⟨t4, a4, b4, -, -, -, u4⟩ := fourth_zero_simple
  obtain ⟨t5, a5, b5, -, -, -, u5⟩ := fifth_zero_simple
  norm_num at htop a1 b1 a2 b2 a3 b3 a4 b4 a5 b5 u1 u2 u3 u4 u5 ⊢
  rcases le_or_gt s.im 15 with c1 | c1
  · have e := congrArg Complex.im (u1 s hz h0 h1 hpos c1)
    rw [im_crit] at e
    left; rw [e]; exact ⟨a1, b1⟩
  rcases le_or_gt s.im (41 / 2) with c2 | c2
  · exact (nozero_g1 s hz h0 h1 c1.le c2).elim
  rcases le_or_gt s.im (43 / 2) with c3 | c3
  · have e := congrArg Complex.im (u2 s hz h0 h1 c2.le c3)
    rw [im_crit] at e
    right; left; rw [e]; exact ⟨a2, b2⟩
  rcases le_or_gt s.im (121 / 5) with c4 | c4
  · exact (nozero_g2 s hz h0 h1 c3.le c4).elim
  rcases le_or_gt s.im (129 / 5) with c5 | c5
  · have e := congrArg Complex.im (u3 s hz h0 h1 c4.le c5)
    rw [im_crit] at e
    right; right; left; rw [e]; exact ⟨a3, b3⟩
  rcases le_or_gt s.im (299 / 10) with c6 | c6
  · exact (nozero_g3 s hz h0 h1 c5.le c6).elim
  rcases le_or_gt s.im (309 / 10) with c7 | c7
  · have e := congrArg Complex.im (u4 s hz h0 h1 c6.le c7)
    rw [im_crit] at e
    right; right; right; left; rw [e]; exact ⟨a4, b4⟩
  rcases le_or_gt s.im (162 / 5) with c8 | c8
  · exact (nozero_g4 s hz h0 h1 c7.le c8).elim
  · have e := congrArg Complex.im (u5 s hz h0 h1 c8.le htop)
    rw [im_crit] at e
    right; right; right; right; rw [e]; exact ⟨a5, b5⟩

/-- **Exactly five zeros below 33.4.** Five points 1/2 + i tᵢ on the critical line, one in each of
(14.13, 14.14), (21.018, 21.026), (25.0069, 25.0149), (30.4209, 30.4289), (32.9311, 32.9391), each
a simple zero of ζ (ζ' ≠ 0, order 1), and every zero ρ of ζ with 0 < Re ρ < 1, 0 < Im ρ ≤ 33.4 is
one of them. -/
theorem exactly_five_zeros_below : ∃ t : Fin 5 → ℝ, StrictMono t ∧
    14.13 < t 0 ∧ t 0 < 14.14 ∧ 21.018 < t 1 ∧ t 1 < 21.026 ∧ 25.0069 < t 2 ∧ t 2 < 25.0149 ∧
    30.4209 < t 3 ∧ t 3 < 30.4289 ∧ 32.9311 < t 4 ∧ t 4 < 32.9391 ∧
    (∀ i, riemannZeta (1 / 2 + t i * I) = 0 ∧ deriv riemannZeta (1 / 2 + t i * I) ≠ 0 ∧
      analyticOrderAt riemannZeta (1 / 2 + t i * I) = 1) ∧
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 0 < s.im → s.im ≤ 33.4 →
      ∃ i, s = 1 / 2 + t i * I := by
  obtain ⟨t1, a1, b1, z1, d1, o1, u1⟩ := first_zero_simple_unique
  obtain ⟨t2, a2, b2, z2, d2, o2, u2⟩ := second_zero_simple
  obtain ⟨t3, a3, b3, z3, d3, o3, u3⟩ := third_zero_simple
  obtain ⟨t4, a4, b4, z4, d4, o4, u4⟩ := fourth_zero_simple
  obtain ⟨t5, a5, b5, z5, d5, o5, u5⟩ := fifth_zero_simple
  refine ⟨![t1, t2, t3, t4, t5], ?_, a1, b1, a2, b2, a3, b3, a4, b4, a5, b5, ?_, ?_⟩
  · refine Fin.strictMono_iff_lt_succ.mpr fun i => ?_
    fin_cases i <;> simp <;> norm_num at * <;> linarith
  · intro i
    fin_cases i
    exacts [⟨z1, d1, o1⟩, ⟨z2, d2, o2⟩, ⟨z3, d3, o3⟩, ⟨z4, d4, o4⟩, ⟨z5, d5, o5⟩]
  · intro s hz h0 h1 hpos htop
    have hmem := zero_im_mem_five s hz h0 h1 hpos htop
    norm_num at htop a1 b1 a2 b2 a3 b3 a4 b4 a5 b5 u1 u2 u3 u4 u5 hmem
    rcases hmem with ⟨l, r⟩ | ⟨l, r⟩ | ⟨l, r⟩ | ⟨l, r⟩ | ⟨l, r⟩
    · exact ⟨0, u1 s hz h0 h1 hpos (by linarith)⟩
    · exact ⟨1, u2 s hz h0 h1 (by linarith) (by linarith)⟩
    · exact ⟨2, u3 s hz h0 h1 (by linarith) (by linarith)⟩
    · exact ⟨3, u4 s hz h0 h1 (by linarith) (by linarith)⟩
    · exact ⟨4, u5 s hz h0 h1 (by linarith) (by linarith)⟩

/-- **N(33.4) = 5**: the nontrivial zeros of ζ with 0 < Im ρ ≤ 33.4 form a set of exactly five
points, all on the critical line. -/
theorem zero_count_33_4 :
    {s : ℂ | riemannZeta s = 0 ∧ 0 < s.re ∧ s.re < 1 ∧ 0 < s.im ∧ s.im ≤ 33.4}.ncard = 5 ∧
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 0 < s.im → s.im ≤ 33.4 → s.re = 1 / 2 := by
  obtain ⟨t, hmono, a1, b1, -, -, -, -, -, -, -, b5, hz, hall⟩ := exactly_five_zeros_below
  have hset : {s : ℂ | riemannZeta s = 0 ∧ 0 < s.re ∧ s.re < 1 ∧ 0 < s.im ∧ s.im ≤ 33.4} =
      Set.range (fun i => (1 / 2 : ℂ) + t i * I) := by
    ext s
    constructor
    · rintro ⟨h0, h1, h2, h3, h4⟩
      obtain ⟨i, rfl⟩ := hall s h0 h1 h2 h3 h4
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      have hlo : t 0 ≤ t i := hmono.monotone (Fin.zero_le i)
      have hhi : t i ≤ t 4 := hmono.monotone (Fin.le_last i)
      refine ⟨(hz i).1, ?_, ?_, ?_, ?_⟩
      · rw [re_crit]; norm_num
      · rw [re_crit]; norm_num
      · rw [im_crit]; norm_num at a1; linarith
      · rw [im_crit]; norm_num at b5 ⊢; linarith
  have hinj : Function.Injective (fun i => (1 / 2 : ℂ) + t i * I) := by
    intro i j hij
    have := congrArg Complex.im hij
    simp only [im_crit] at this
    exact hmono.injective this
  refine ⟨?_, fun s h0 h1 h2 h3 h4 => ?_⟩
  · rw [hset, Set.ncard_range_of_injective hinj, Nat.card_eq_fintype_card, Fintype.card_fin]
  · obtain ⟨i, rfl⟩ := hall s h0 h1 h2 h3 h4
    exact re_crit _

end Fayed.FirstZero

#print axioms Fayed.FirstZero.zero_im_mem_five
#print axioms Fayed.FirstZero.exactly_five_zeros_below
#print axioms Fayed.FirstZero.zero_count_33_4
