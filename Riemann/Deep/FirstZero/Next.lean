/-- **The first five zeros: five distinct points on the critical line where ζ vanishes,**
one in each of (14.13, 14.14), (21.018, 21.026), (25.0069, 25.0149), (30.4209, 30.4289),
(32.9311, 32.9391). -/
theorem first_five_zeros : ∃ t : Fin 5 → ℝ, StrictMono t ∧
    14.13 < t 0 ∧ t 0 < 14.14 ∧ 21.018 < t 1 ∧ t 1 < 21.026 ∧ 25.0069 < t 2 ∧ t 2 < 25.0149 ∧
    30.4209 < t 3 ∧ t 3 < 30.4289 ∧ 32.9311 < t 4 ∧ t 4 < 32.9391 ∧
    ∀ i, riemannZeta ((1 / 2 : ℂ) + t i * Complex.I) = 0 := by
  obtain ⟨t1, h1a, h1b, h1⟩ := first_zero
  obtain ⟨t2, h2a, h2b, h2⟩ := second_zero
  obtain ⟨t3, h3a, h3b, h3⟩ := third_zero
  obtain ⟨t4, h4a, h4b, h4⟩ := fourth_zero
  obtain ⟨t5, h5a, h5b, h5⟩ := fifth_zero
  refine ⟨![t1, t2, t3, t4, t5], ?_, h1a, h1b, h2a, h2b, h3a, h3b, h4a, h4b, h5a, h5b, ?_⟩
  · refine Fin.strictMono_iff_lt_succ.mpr fun i => ?_
    fin_cases i <;> simp <;> norm_num at * <;> linarith
  · intro i
    fin_cases i
    exacts [h1, h2, h3, h4, h5]

/-- The five zeros as distinct points ρ of the critical line Re ρ = 1/2. -/
theorem five_distinct_critical_zeros : ∃ ρ : Fin 5 → ℂ, Function.Injective ρ ∧
    ∀ i, (ρ i).re = 1 / 2 ∧ riemannZeta (ρ i) = 0 := by
  obtain ⟨t, hmono, -, -, -, -, -, -, -, -, -, -, hz⟩ := first_five_zeros
  refine ⟨fun i => (1 / 2 : ℂ) + t i * Complex.I, ?_, fun i => ⟨by simp, hz i⟩⟩
  intro i j hij
  have := congrArg Complex.im hij
  simp at this
  exact hmono.injective this

end Fayed.FirstZero
