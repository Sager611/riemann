import Riemann.Deep.FirstZero.NextCert2
import Riemann.Deep.FirstZero.NextCert3
import Riemann.Deep.FirstZero.NextCert4
import Riemann.Deep.FirstZero.NextCert5

/-!
# The second to fifth zeros of ζ on the critical line, certified in Lean

γ₂ ≈ 21.0220, γ₃ ≈ 25.0109, γ₄ ≈ 30.4249, γ₅ ≈ 32.9351. For each, two points t₁ < t₂ = t₁ + 0.008
straddle the zero; order-8 Euler–Maclaurin with N = 16 (NextCert*.lean, generated by
.scratch/firstzero2/gen_next.py) encloses ζ there, `Gammaℝ_ratio_gen` bounds the Γℝ phase drift and
`crit_zero_of_balls` (NextLib.lean) turns the resulting sign change of Λ(1/2 + it) into a zero.
-/

open Complex Set

namespace Fayed.FirstZero

/-- **The second zero of ζ on the critical line lies in (21.018, 21.026).** -/
theorem second_zero : ∃ t : ℝ, 21.018 < t ∧ t < 21.026 ∧
    riemannZeta ((1 / 2 : ℂ) + t * Complex.I) = 0 := by
  obtain ⟨t, ht, h⟩ := crit_zero_of_balls (t1 := (10509 / 500 : ℝ)) (t2 := (10513 / 500 : ℝ)) (by norm_num)
    (c := (48917 / 200000 : ℝ)) (R := (2059467 / 31250000000000 : ℝ)) (by norm_num) Next2.zeta_a Next2.zeta_b
    (Gammaℝ_ratio_gen (δ := 4 / 1000) (S := (23681 / 125000 : ℝ)) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num))
    (by norm_num) (by norm_num)
  refine ⟨t, ?_, ?_, h⟩
  · have := ht.1; norm_num at this ⊢; linarith
  · have := ht.2; norm_num at this ⊢; linarith

