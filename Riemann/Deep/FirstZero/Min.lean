namespace Fayed.FirstZero

/-- No zero of ζ in the critical strip with 0 < Im s < 14.13. -/
theorem no_zero_below : ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 0 < s.im →
    s.im < 14.13 → False := by
  intro s hz h0 h1 hi0 hi1
  obtain ⟨t1, ht1a, _, _, hu⟩ := Min.Cert.unique_below
  have := congrArg Complex.im (hu s hz h0 h1 hi0 (by linarith))
  simp at this
  linarith

/-- The only zero of ζ in the critical strip with 0 < Im s ≤ 15 is the certified one. -/
theorem zeros_below_15 : ∃ t1 : ℝ, 14.13 < t1 ∧ t1 < 14.14 ∧ riemannZeta (1 / 2 + t1 * I) = 0 ∧
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 0 < s.im → s.im ≤ 15 →
      s = 1 / 2 + t1 * I := by
  simpa using Min.Cert.unique_below

/-- **The certified zero is the first one**: no zero of ζ in the critical strip has a smaller
positive ordinate. -/
theorem first_zero_is_first : ∃ t1 : ℝ, 14.13 < t1 ∧ t1 < 14.14 ∧
    riemannZeta (1 / 2 + t1 * I) = 0 ∧
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 0 < s.im → t1 ≤ s.im := by
  obtain ⟨t1, ha, hb, hz, hu⟩ := Min.Cert.unique_below
  refine ⟨t1, ha, hb, hz, fun s hs h0 h1 hi => ?_⟩
  rcases le_or_gt s.im (15 : ℝ) with h | h
  · have := congrArg Complex.im (hu s hs h0 h1 hi h)
    simp at this
    linarith
  · norm_num at h; linarith

end Fayed.FirstZero
