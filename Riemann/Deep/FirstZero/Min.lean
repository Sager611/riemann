theorem right_bd : arg (riemannZeta ((((2 : ℝ)) : ℂ) + (((15 : ℝ)) : ℂ) * I)) ≤ (317497931451711 / 1000000000000000 : ℝ) :=
  arg_up_one zeta_T4 (by norm_num) (by norm_num) (by norm_num)

theorem unique_below : ∃ t1 : ℝ, 14.13 < t1 ∧ t1 < 14.14 ∧ riemannZeta (1 / 2 + t1 * I) = 0 ∧
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re → s.re < 1 → 0 < s.im → s.im ≤ (15 : ℝ) →
      s = 1 / 2 + t1 * I :=
  unique_of_cert (σL := (1 / 4 : ℝ)) (T := (15 : ℝ)) (by norm_num) (by norm_num) (by norm_num)
    top_all left_all right_bd (by have := Real.pi_gt_d2; norm_num at this ⊢; linarith)

